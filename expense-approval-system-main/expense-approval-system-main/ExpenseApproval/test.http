### ================================
### 1. Submit Expense (Employee - VALID)
### ================================
POST http://localhost:8080/expenses/submit
Content-Type: application/json

{
  "userId": 1,
  "amount": 500,
  "description": "Flight ticket"
}

### ================================
### 2. Get All Expenses
### ================================
GET http://localhost:8080/expenses


### ================================
### 3. Get Expenses by User (Employee)
### ================================
GET http://localhost:8080/expenses/user/1


### ================================
### 4. Approve Expense (Manager - VALID)
### ================================
PUT http://localhost:8080/expenses/1/approve
Content-Type: application/json

{
  "userId": 2
}


### ================================
### 5. Reject Expense (Manager - VALID)
### ================================
PUT http://localhost:8080/expenses/1/reject
Content-Type: application/json

{
  "userId": 2
}


### ================================
### 6. Reimburse Expense (Finance - VALID)
### ================================
PUT http://localhost:8080/expenses/1/reimburse
Content-Type: application/json

{
  "userId": 3
}


### ================================
### 7. INVALID: Manager tries to submit (should FAIL)
### ================================
POST http://localhost:8080/expenses/submit
Content-Type: application/json

{
  "userId": 2,
  "amount": 300,
  "description": "Manager test expense"
}


### ================================
### 8. INVALID: Employee tries to approve (should FAIL)
### ================================
PUT http://localhost:8080/expenses/1/approve
Content-Type: application/json

{
  "userId": 1
}


### ================================
### 9. INVALID: Reimburse without approval (should FAIL)
### ================================
POST http://localhost:8080/expenses/submit
Content-Type: application/json

{
  "userId": 1,
  "amount": 200,
  "description": "Unapproved expense"
}

###
PUT http://localhost:8080/expenses/2/reimburse
Content-Type: application/json

{
  "userId": 3
}


### ================================
### 10. INVALID: Expense not found
### ================================
PUT http://localhost:8080/expenses/999/approve
Content-Type: application/json

{
  "userId": 2
}